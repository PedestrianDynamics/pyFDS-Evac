&HEAD CHID='demo_homogeneous_CO_v2',
      TITLE='30x30 m sealed room, homogeneous 4000 ppm CO, FED hand-calc validation (v2)' /

! ============================================================
! DOMAIN
! 30x30 m floor, 3 m ceiling, 0.5 m cells.
! Split into 4 equal quadrants for MPI (2x2 grid).
! Run with: mpiexec -n 4 fds demo_homogeneous_CO_v2.fds
! ============================================================
&MESH ID='M1', IJK=30,30,6, XB= 0,15, 0,15, 0,3 /
&MESH ID='M2', IJK=30,30,6, XB=15,30, 0,15, 0,3 /
&MESH ID='M3', IJK=30,30,6, XB= 0,15,15,30, 0,3 /
&MESH ID='M4', IJK=30,30,6, XB=15,30,15,30, 0,3 /

&TIME T_END=420 /

! ============================================================
! SPECIES
! Background is NITROGEN so every species (including O2) is
! fully explicit -- no double-counting of O2 that would occur
! when background is AIR.
!
! Hand-calc reference (CO only, no CO2/O2 correction):
!   FED_CO(t) = (4000^1.036 * t_min) / 35000
!   FED=0.3 at t~117 s, FED=1.0 at t~390 s
! ============================================================
&SPEC ID='NITROGEN',       BACKGROUND=.TRUE. /
&SPEC ID='OXYGEN'                            /
&SPEC ID='CARBON MONOXIDE'                   /
&SPEC ID='CARBON DIOXIDE'                    /
&SPEC ID='SOOT'                              /

! Initial concentrations (mass fractions, homogeneous throughout domain):
!   CO   : 4000 ppm volume fraction -> mass fraction 3.8674e-3
!   CO2  : small background         -> mass fraction 7.596e-4
!   O2   : ambient 20.9 % vol       -> mass fraction 2.3086e-1
!   Soot : gives visibility ~3 m    -> mass fraction 9.5785e-5
!   N2   : remainder (background, not listed)
&INIT SPEC_ID(1)='CARBON MONOXIDE',
      SPEC_ID(2)='CARBON DIOXIDE',
      SPEC_ID(3)='OXYGEN',
      SPEC_ID(4)='SOOT',
      MASS_FRACTION(1)=3.8674E-3,
      MASS_FRACTION(2)=7.596E-4,
      MASS_FRACTION(3)=2.3086E-1,
      MASS_FRACTION(4)=9.5785E-5 /

! ============================================================
! SLICE OUTPUTS
! CO at multiple heights -- confirms spatial homogeneity.
! CO2 and O2 at z=2.0 m -- required by pyFDS-Evac FED sampler.
! Visibility and extinction for smoke characterisation.
! ============================================================

! CO volume fraction (horizontal)
&SLCF PBZ=0.5, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE' /
&SLCF PBZ=1.5, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE' /
&SLCF PBZ=2.0, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE' /
&SLCF PBZ=2.5, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE' /

! CO2 and O2 at breathing height (pyFDS-Evac requirement)
&SLCF PBZ=2.0, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON DIOXIDE' /
&SLCF PBZ=2.0, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN'         /

! Visibility and extinction (horizontal)
&SLCF PBZ=0.5, QUANTITY='VISIBILITY' /
&SLCF PBZ=1.5, QUANTITY='VISIBILITY' /
&SLCF PBZ=2.0, QUANTITY='VISIBILITY' /
&SLCF PBZ=2.5, QUANTITY='VISIBILITY' /
&SLCF PBZ=2.0, QUANTITY='EXTINCTION' /
&SLCF PBZ=2.0, QUANTITY='MASS FRACTION', SPEC_ID='SOOT' /

! CO volume fraction (vertical cross-sections -- homogeneity checks)
&SLCF PBY=15.0, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE' /
&SLCF PBY=15.0, QUANTITY='VISIBILITY'  /
&SLCF PBY=15.0, QUANTITY='EXTINCTION'  /
&SLCF PBX=15.0, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE' /
&SLCF PBX=15.0, QUANTITY='VISIBILITY'  /

! ============================================================
! POINT DEVICES
! CO concentration -- should read ~4000 ppm (0.004 vol frac) everywhere.
! FED             -- compare against hand-calc curve above.
! Visibility      -- should read ~3 m everywhere, constant.
! Extinction      -- related to visibility via Vis = C/K (C=3 here).
! ============================================================

! CO concentration
&DEVC XB= 8, 8, 8, 8,2,2,   QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE', ID='CO_corner_SW' /
&DEVC XB=22,22,22,22,2,2,   QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE', ID='CO_corner_NE' /
&DEVC XB=14.9,14.9,14.9,14.9,2,2,   QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE', ID='CO_center'      /
&DEVC XB=14.9,14.9,14.9,14.9,0.5,0.5, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE', ID='CO_center_low'  /
&DEVC XB=14.9,14.9,14.9,14.9,2.5,2.5, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE', ID='CO_center_high' /

! FED (FDS built-in, CO only)
&DEVC XB= 8, 8, 8, 8,2,2,   QUANTITY='FED', ID='FED_corner_SW' /
&DEVC XB=22,22,22,22,2,2,   QUANTITY='FED', ID='FED_corner_NE' /
&DEVC XB=14.9,14.9,14.9,14.9,2,2,   QUANTITY='FED', ID='FED_center'    /

! Visibility
&DEVC XB= 8, 8, 8, 8,2,2,   QUANTITY='VISIBILITY', ID='VIS_corner_SW'  /
&DEVC XB=22,22,22,22,2,2,   QUANTITY='VISIBILITY', ID='VIS_corner_NE'  /
&DEVC XB=14.9,14.9,14.9,14.9,2,2,   QUANTITY='VISIBILITY', ID='VIS_center'    /
&DEVC XB=14.9,14.9,14.9,14.9,0.5,0.5, QUANTITY='VISIBILITY', ID='VIS_center_low'  /
&DEVC XB=14.9,14.9,14.9,14.9,2.5,2.5, QUANTITY='VISIBILITY', ID='VIS_center_high' /

! Extinction coefficient
&DEVC XB= 8, 8, 8, 8,2,2,   QUANTITY='EXTINCTION', ID='EXT_corner_SW' /
&DEVC XB=22,22,22,22,2,2,   QUANTITY='EXTINCTION', ID='EXT_corner_NE' /
&DEVC XB=14.9,14.9,14.9,14.9,2,2,   QUANTITY='EXTINCTION', ID='EXT_center'   /

&TAIL /
