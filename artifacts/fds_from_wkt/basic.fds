&HEAD CHID='verif_basic', TITLE='Generated from JuPedSim walkable WKT' /
&MESH IJK=302,202,30, XB=-0.100,30.100,-0.100,20.100,0.0,3.0 /
&TIME T_END=120.0 /
&MISC TMPA=20.0 /

! --- walls: complement of the walkable area (19 OBSTs) ---
&OBST XB=-0.100,30.100,-0.100,0.000,0.0,3.0 /
&OBST XB=-0.100,0.000,0.000,20.100,0.0,3.0 /
&OBST XB=0.000,10.000,5.000,5.100,0.0,3.0 /
&OBST XB=0.000,2.000,15.000,15.100,0.0,3.0 /
&OBST XB=0.000,30.100,20.000,20.100,0.0,3.0 /
&OBST XB=3.000,24.000,15.000,15.100,0.0,3.0 /
&OBST XB=4.000,13.000,8.000,8.100,0.0,3.0 /
&OBST XB=4.000,4.100,8.100,15.000,0.0,3.0 /
&OBST XB=11.000,19.000,5.000,5.100,0.0,3.0 /
&OBST XB=14.000,19.000,8.000,8.100,0.0,3.0 /
&OBST XB=15.000,15.100,0.000,4.900,0.0,3.0 /
&OBST XB=18.900,19.000,0.000,5.000,0.0,3.0 /
&OBST XB=18.900,19.000,5.100,6.000,0.0,3.0 /
&OBST XB=18.900,19.000,7.000,8.000,0.0,3.0 /
&OBST XB=18.900,19.000,8.100,15.000,0.0,3.0 /
&OBST XB=18.900,19.000,15.100,20.000,0.0,3.0 /
&OBST XB=26.000,30.100,15.000,15.100,0.0,3.0 /
&OBST XB=30.000,30.100,0.000,15.000,0.0,3.0 /
&OBST XB=30.000,30.100,15.100,20.000,0.0,3.0 /

! --- fire (edit to taste; not derived from geometry) ---
&REAC FUEL='PROPANE', SOOT_YIELD=0.06, CO_YIELD=0.01 /
&VENT XB=11.250,11.750,11.300,11.800,0.0,0.0, SURF_ID='BURNER' /
&SURF ID='BURNER', HRRPUA=800.0, COLOR='RED', RAMP_Q='qramp' /
&RAMP ID='qramp', T=0.0, F=0.0 /
&RAMP ID='qramp', T=10.0, F=1.0 /

! --- analysis slices at z=2.0 m (pyFDS-Evac quantities) ---
&SLCF PBZ=2.0, QUANTITY='SOOT EXTINCTION COEFFICIENT' /
&SLCF PBZ=2.0, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE' /
&SLCF PBZ=2.0, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON DIOXIDE' /
&SLCF PBZ=2.0, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN' /
&DUMP DT_SLCF=2.0 /

&TAIL /
