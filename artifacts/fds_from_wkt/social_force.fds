&HEAD CHID='verif_social_force', TITLE='Generated from JuPedSim walkable WKT' /
&MESH IJK=302,202,30, XB=-15.100,15.100,-10.100,10.100,0.0,3.0 /
&TIME T_END=120.0 /
&MISC TMPA=20.0 /

! --- walls: complement of the walkable area (19 OBSTs) ---
&OBST XB=-15.100,15.100,-10.100,-10.000,0.0,3.0 /
&OBST XB=-15.100,-15.000,-10.000,10.100,0.0,3.0 /
&OBST XB=-15.000,-5.000,-5.000,-4.900,0.0,3.0 /
&OBST XB=-15.000,-13.000,5.000,5.100,0.0,3.0 /
&OBST XB=-15.000,15.100,10.000,10.100,0.0,3.0 /
&OBST XB=-12.000,9.000,5.000,5.100,0.0,3.0 /
&OBST XB=-11.000,-2.000,-2.000,-1.900,0.0,3.0 /
&OBST XB=-11.000,-10.900,-1.900,5.000,0.0,3.0 /
&OBST XB=-4.000,4.000,-5.000,-4.900,0.0,3.0 /
&OBST XB=-1.000,4.000,-2.000,-1.900,0.0,3.0 /
&OBST XB=0.000,0.100,-10.000,-5.100,0.0,3.0 /
&OBST XB=3.900,4.000,-10.000,-5.000,0.0,3.0 /
&OBST XB=3.900,4.000,-4.900,-4.000,0.0,3.0 /
&OBST XB=3.900,4.000,-3.000,-2.000,0.0,3.0 /
&OBST XB=3.900,4.000,-1.900,5.000,0.0,3.0 /
&OBST XB=3.900,4.000,5.100,10.000,0.0,3.0 /
&OBST XB=11.000,15.100,5.000,5.100,0.0,3.0 /
&OBST XB=15.000,15.100,-10.000,5.000,0.0,3.0 /
&OBST XB=15.000,15.100,5.100,10.000,0.0,3.0 /

! --- fire (edit to taste; not derived from geometry) ---
&REAC FUEL='PROPANE', SOOT_YIELD=0.06, CO_YIELD=0.01 /
&VENT XB=-3.750,-3.250,1.300,1.800,0.0,0.0, SURF_ID='BURNER' /
&SURF ID='BURNER', HRRPUA=800.0, COLOR='RED', RAMP_Q='qramp' /
&RAMP ID='qramp', T=0.0, F=0.0 /
&RAMP ID='qramp', T=10.0, F=1.0 /

! --- analysis slices at z=2.0 m (pyFDS-Evac quantities) ---
&SLCF PBZ=2.0, QUANTITY='SOOT EXTINCTION COEFFICIENT' /
&SLCF PBZ=2.0, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE' /
&SLCF PBZ=2.0, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON DIOXIDE' /
&SLCF PBZ=2.0, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN' /
&DUMP DT_SLCF=2.0 /

&TAIL /
