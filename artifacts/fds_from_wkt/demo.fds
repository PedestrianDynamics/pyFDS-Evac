&HEAD CHID='verif_demo', TITLE='Generated from JuPedSim walkable WKT' /
&MESH IJK=122,54,12, XB=-0.250,30.250,-0.250,13.250,0.0,3.0 /
&TIME T_END=120.0 /
&MISC TMPA=20.0 /

! --- walls: complement of the walkable area (6 OBSTs) ---
&OBST XB=-0.250,30.250,-0.250,0.000,0.0,3.0 /
&OBST XB=-0.250,17.000,0.000,10.000,0.0,3.0 /
&OBST XB=-0.250,0.000,10.000,13.250,0.0,3.0 /
&OBST XB=0.000,30.250,13.000,13.250,0.0,3.0 /
&OBST XB=23.000,30.250,0.000,10.000,0.0,3.0 /
&OBST XB=30.000,30.250,10.000,13.000,0.0,3.0 /

! --- fire (edit to taste; not derived from geometry) ---
&REAC FUEL='PROPANE', SOOT_YIELD=0.06, CO_YIELD=0.01 /
&VENT XB=19.750,20.250,4.750,5.250,0.0,0.0, SURF_ID='BURNER' /
&SURF ID='BURNER', HRRPUA=800.0, COLOR='RED', RAMP_Q='qramp' /
&RAMP ID='qramp', T=0.0, F=0.0 /
&RAMP ID='qramp', T=10.0, F=1.0 /

! --- analysis slices at z=2.0 m (pyFDS-Evac quantities) ---
&SLCF PBZ=2.0, QUANTITY='SOOT EXTINCTION COEFFICIENT' /
&SLCF PBZ=2.0, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE' /
&SLCF PBZ=2.0, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON DIOXIDE' /
&SLCF PBZ=2.0, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN' /
&DUMP DT_SLCF=2.0 /

&TAIL /
