&HEAD CHID='cvm2_ballroom', TITLE='CVM2 Grand Ballroom, scenario CF, fast t2 fire to 2700 kW' /

! Issue #808. After MBIE (2012), Commentary for Verification Method C/VM2,
! Appendix B, design scenario CF in the Grand Ballroom. Written for
! FDS 6.7.7 (Evac 2.6.1). NOT RUN: no FDS was available when this was written.
! Tags: [P] published, [D] document inconsistent, [A] assumed; see README.md.
! Generated by make_decks.py; do not edit by hand.
! Phase 3 of 3, every repeat: evacuation meshes only; reads CHID_evac.eff and CHID_evac.fed.
&MISC EVACUATION_MC_MODE=.TRUE. /

! --- Fire meshes: 21 meshes, 400000 cells, dx 0.25 m [A] ---
&MESH ID='F11', IJK=30,32,20, XB=-2.5,5.0,0.0,8.0,0.0,5.0 /  ! 19200 cells
&MESH ID='F12', IJK=40,32,20, XB=5.0,15.0,0.0,8.0,0.0,5.0 /  ! 25600 cells
&MESH ID='F13', IJK=30,32,20, XB=15.0,22.5,0.0,8.0,0.0,5.0 /  ! 19200 cells
&MESH ID='F21', IJK=30,32,20, XB=-2.5,5.0,8.0,16.0,0.0,5.0 /  ! 19200 cells
&MESH ID='F22', IJK=40,32,20, XB=5.0,15.0,8.0,16.0,0.0,5.0 /  ! 25600 cells
&MESH ID='F23', IJK=30,32,20, XB=15.0,22.5,8.0,16.0,0.0,5.0 /  ! 19200 cells
&MESH ID='F31', IJK=30,24,20, XB=-2.5,5.0,16.0,22.0,0.0,5.0 /  ! 14400 cells
&MESH ID='F32', IJK=40,24,20, XB=5.0,15.0,16.0,22.0,0.0,5.0 /  ! 19200 cells
&MESH ID='F33', IJK=30,24,20, XB=15.0,22.5,16.0,22.0,0.0,5.0 /  ! 14400 cells
&MESH ID='F41', IJK=30,24,20, XB=-2.5,5.0,22.0,28.0,0.0,5.0 /  ! 14400 cells
&MESH ID='F42', IJK=40,24,20, XB=5.0,15.0,22.0,28.0,0.0,5.0 /  ! 19200 cells
&MESH ID='F43', IJK=30,24,20, XB=15.0,22.5,22.0,28.0,0.0,5.0 /  ! 14400 cells
&MESH ID='F51', IJK=30,24,20, XB=-2.5,5.0,28.0,34.0,0.0,5.0 /  ! 14400 cells
&MESH ID='F52', IJK=40,24,20, XB=5.0,15.0,28.0,34.0,0.0,5.0 /  ! 19200 cells
&MESH ID='F53', IJK=30,24,20, XB=15.0,22.5,28.0,34.0,0.0,5.0 /  ! 14400 cells
&MESH ID='F61', IJK=30,40,20, XB=-2.5,5.0,34.0,44.0,0.0,5.0 /  ! 24000 cells
&MESH ID='F62', IJK=40,40,20, XB=5.0,15.0,34.0,44.0,0.0,5.0 /  ! 32000 cells
&MESH ID='F63', IJK=30,40,20, XB=15.0,22.5,34.0,44.0,0.0,5.0 /  ! 24000 cells
&MESH ID='F71', IJK=30,24,20, XB=-2.5,5.0,44.0,50.0,0.0,5.0 /  ! 14400 cells
&MESH ID='F72', IJK=40,24,20, XB=5.0,15.0,44.0,50.0,0.0,5.0 /  ! 19200 cells
&MESH ID='F73', IJK=30,24,20, XB=15.0,22.5,44.0,50.0,0.0,5.0 /  ! 14400 cells

&TIME T_END=1200.0 /
&DUMP DT_SLCF=1.0, DT_DEVC=1.0, DT_HRR=1.0 /

! --- Reaction: C/VM2 Table 2.1 (Commentary p. 56) [P]; formula [A] ---
! CH2.686O0.592: C from the CO2, CO and soot yields, H from the H2O
! yield, O the rest, so that FDS returns CO2 1.5 and H2O 1.0 kg/kg.
&REAC FUEL='CVM2_FUEL', C=1.0, H=2.6856, O=0.5920,
      SOOT_YIELD=0.07, CO_YIELD=0.04,
      HEAT_OF_COMBUSTION=20000.0, RADIATIVE_FRACTION=0.35 /

! --- Fire: 0.0469 t2 kW to 2700.0 kW at 239.9 s, then held [P] ---
! Burner 2.0 x 2.0 m in the room centre, top at 0.5 m [A]; HRRPUA = 2700.0 / 4.0.
&SURF ID='FIRE', HRRPUA=675.0, TAU_Q=-239.9, COLOR='RED' /
&OBST XB=9.0,11.0,24.0,26.0,0.0,0.5, SURF_IDS='FIRE','INERT','INERT' /  ! burner

! --- Walls and doors. North and south walls, floor and ceiling are
! the mesh boundary (INERT) [A]. Doors open throughout [A]. ---
&OBST XB=-0.5,0.0,0.0,50.0,0.0,5.0 /  ! west wall
&OBST XB=20.0,20.5,0.0,50.0,0.0,5.0 /  ! east wall
&HOLE XB=-0.51,0.01,10.5,12.5,0.0,2.0, EVACUATION=.FALSE. /  ! door WestSouth, fire meshes
&HOLE XB=-0.51,0.01,40.5,42.5,0.0,2.0, EVACUATION=.FALSE. /  ! door WestNorth, fire meshes
&HOLE XB=19.99,20.51,10.5,12.5,0.0,2.0, EVACUATION=.FALSE. /  ! door EastSouth, fire meshes
&HOLE XB=19.99,20.51,40.5,42.5,0.0,2.0, EVACUATION=.FALSE. /  ! door EastNorth, fire meshes

! --- Exterior strips: OPEN outer faces, ends and tops [A] ---
&VENT XB=-2.5,-2.5,0.0,50.0,0.0,5.0, SURF_ID='OPEN' /
&VENT XB=22.5,22.5,0.0,50.0,0.0,5.0, SURF_ID='OPEN' /
&VENT XB=-2.5,-0.5,0.0,0.0,0.0,5.0, SURF_ID='OPEN' /
&VENT XB=-2.5,-0.5,50.0,50.0,0.0,5.0, SURF_ID='OPEN' /
&VENT XB=-2.5,-0.5,0.0,50.0,5.0,5.0, SURF_ID='OPEN' /
&VENT XB=20.5,22.5,0.0,0.0,0.0,5.0, SURF_ID='OPEN' /
&VENT XB=20.5,22.5,50.0,50.0,0.0,5.0, SURF_ID='OPEN' /
&VENT XB=20.5,22.5,0.0,50.0,5.0,5.0, SURF_ID='OPEN' /

! --- Detection: C/VM2 Table 3.2 (p. 88) [P], layout [A] ---
! OD_*: optical density at the detector; t_d = first time above 0.097 1/m.
! SD_*: Heskestad spot detector at the same obscuration, 20.0 %/m, with
! the FDS default entry lag; for comparison only.
&PROP ID='SD', QUANTITY='CHAMBER OBSCURATION', ACTIVATION_OBSCURATION=20.0 /
&DEVC ID='OD_01', QUANTITY='OPTICAL DENSITY', XYZ=3.33,4.17,4.9, SETPOINT=0.097 /
&DEVC ID='SD_01', PROP_ID='SD', XYZ=3.33,4.17,4.9 /
&DEVC ID='OD_02', QUANTITY='OPTICAL DENSITY', XYZ=3.33,12.5,4.9, SETPOINT=0.097 /
&DEVC ID='SD_02', PROP_ID='SD', XYZ=3.33,12.5,4.9 /
&DEVC ID='OD_03', QUANTITY='OPTICAL DENSITY', XYZ=3.33,20.83,4.9, SETPOINT=0.097 /
&DEVC ID='SD_03', PROP_ID='SD', XYZ=3.33,20.83,4.9 /
&DEVC ID='OD_04', QUANTITY='OPTICAL DENSITY', XYZ=3.33,29.17,4.9, SETPOINT=0.097 /
&DEVC ID='SD_04', PROP_ID='SD', XYZ=3.33,29.17,4.9 /
&DEVC ID='OD_05', QUANTITY='OPTICAL DENSITY', XYZ=3.33,37.5,4.9, SETPOINT=0.097 /
&DEVC ID='SD_05', PROP_ID='SD', XYZ=3.33,37.5,4.9 /
&DEVC ID='OD_06', QUANTITY='OPTICAL DENSITY', XYZ=3.33,45.83,4.9, SETPOINT=0.097 /
&DEVC ID='SD_06', PROP_ID='SD', XYZ=3.33,45.83,4.9 /
&DEVC ID='OD_07', QUANTITY='OPTICAL DENSITY', XYZ=10.0,4.17,4.9, SETPOINT=0.097 /
&DEVC ID='SD_07', PROP_ID='SD', XYZ=10.0,4.17,4.9 /
&DEVC ID='OD_08', QUANTITY='OPTICAL DENSITY', XYZ=10.0,12.5,4.9, SETPOINT=0.097 /
&DEVC ID='SD_08', PROP_ID='SD', XYZ=10.0,12.5,4.9 /
&DEVC ID='OD_09', QUANTITY='OPTICAL DENSITY', XYZ=10.0,20.83,4.9, SETPOINT=0.097 /
&DEVC ID='SD_09', PROP_ID='SD', XYZ=10.0,20.83,4.9 /
&DEVC ID='OD_10', QUANTITY='OPTICAL DENSITY', XYZ=10.0,29.17,4.9, SETPOINT=0.097 /
&DEVC ID='SD_10', PROP_ID='SD', XYZ=10.0,29.17,4.9 /
&DEVC ID='OD_11', QUANTITY='OPTICAL DENSITY', XYZ=10.0,37.5,4.9, SETPOINT=0.097 /
&DEVC ID='SD_11', PROP_ID='SD', XYZ=10.0,37.5,4.9 /
&DEVC ID='OD_12', QUANTITY='OPTICAL DENSITY', XYZ=10.0,45.83,4.9, SETPOINT=0.097 /
&DEVC ID='SD_12', PROP_ID='SD', XYZ=10.0,45.83,4.9 /
&DEVC ID='OD_13', QUANTITY='OPTICAL DENSITY', XYZ=16.67,4.17,4.9, SETPOINT=0.097 /
&DEVC ID='SD_13', PROP_ID='SD', XYZ=16.67,4.17,4.9 /
&DEVC ID='OD_14', QUANTITY='OPTICAL DENSITY', XYZ=16.67,12.5,4.9, SETPOINT=0.097 /
&DEVC ID='SD_14', PROP_ID='SD', XYZ=16.67,12.5,4.9 /
&DEVC ID='OD_15', QUANTITY='OPTICAL DENSITY', XYZ=16.67,20.83,4.9, SETPOINT=0.097 /
&DEVC ID='SD_15', PROP_ID='SD', XYZ=16.67,20.83,4.9 /
&DEVC ID='OD_16', QUANTITY='OPTICAL DENSITY', XYZ=16.67,29.17,4.9, SETPOINT=0.097 /
&DEVC ID='SD_16', PROP_ID='SD', XYZ=16.67,29.17,4.9 /
&DEVC ID='OD_17', QUANTITY='OPTICAL DENSITY', XYZ=16.67,37.5,4.9, SETPOINT=0.097 /
&DEVC ID='SD_17', PROP_ID='SD', XYZ=16.67,37.5,4.9 /
&DEVC ID='OD_18', QUANTITY='OPTICAL DENSITY', XYZ=16.67,45.83,4.9, SETPOINT=0.097 /
&DEVC ID='SD_18', PROP_ID='SD', XYZ=16.67,45.83,4.9 /

! --- Slices: docs/fds-case-requirements.md, at 2.0 m and 1.5 m ---
&SLCF PBZ=2.0, QUANTITY='EXTINCTION COEFFICIENT' /
&SLCF PBZ=2.0, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE' /
&SLCF PBZ=2.0, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON DIOXIDE' /
&SLCF PBZ=2.0, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN' /
&SLCF PBZ=2.0, QUANTITY='TEMPERATURE' /
&SLCF PBZ=1.5, QUANTITY='EXTINCTION COEFFICIENT' /
&SLCF PBZ=1.5, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE' /
&SLCF PBZ=1.5, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON DIOXIDE' /
&SLCF PBZ=1.5, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN' /
&SLCF PBZ=1.5, QUANTITY='TEMPERATURE' /

! --- FDS+Evac: evacuation mesh, dx 0.25 m, floor at z 0 [A] ---
&MESH ID='Ballroom', IJK=84,200,1, XB=-0.5,20.5,0.0,50.0,0.4,1.6,
      EVACUATION=.TRUE., EVAC_HUMANS=.TRUE., EVAC_Z_OFFSET=1.0 /
&SURF ID='EVAC_WALL', RGB=200,0,200, EVAC_DEFAULT=.TRUE. /

! Doorways in the evacuation meshes, full height: the automatic
! visibility mesh is centred on HUMAN_SMOKE_HEIGHT 2.0 m, where the
! fire-mesh door ends [A].
&HOLE XB=-0.51,0.01,10.5,12.5,0.0,5.0, EVACUATION=.TRUE. /  ! door WestSouth
&HOLE XB=-0.51,0.01,40.5,42.5,0.0,5.0, EVACUATION=.TRUE. /  ! door WestNorth
&HOLE XB=19.99,20.51,10.5,12.5,0.0,5.0, EVACUATION=.TRUE. /  ! door EastSouth
&HOLE XB=19.99,20.51,40.5,42.5,0.0,5.0, EVACUATION=.TRUE. /  ! door EastNorth

! Exits on the outer wall face; all four lead to safety [A].
&EXIT ID='WestSouth', IOR=-1, XB=-0.5,-0.5,10.5,12.5,0.4,1.6, XYZ=0.5,11.5,1.0 /
&EXIT ID='WestNorth', IOR=-1, XB=-0.5,-0.5,40.5,42.5,0.4,1.6, XYZ=0.5,41.5,1.0 /
&EXIT ID='EastSouth', IOR=+1, XB=20.5,20.5,10.5,12.5,0.4,1.6, XYZ=19.5,11.5,1.0 /
&EXIT ID='EastNorth', IOR=+1, XB=20.5,20.5,40.5,42.5,0.4,1.6, XYZ=19.5,41.5,1.0 /

! Agents: constant speed, body size, detection and reaction time [A]/[P].
&PERS ID='Occupant', DEFAULT_PROPERTIES='Adult',
      VELOCITY_DIST=0, VEL_MEAN=1.2,
      DIAMETER_DIST=0, DIA_MEAN=0.51,
      DET_EVAC_DIST=0, DET_MEAN=96.0,
      PRE_EVAC_DIST=0, PRE_MEAN=30.0,
      HUMAN_SMOKE_HEIGHT=2.0, FED_DOOR_CRIT=-1000.0,
      OUTPUT_FED=.TRUE., OUTPUT_SPEED=.TRUE., COLOR_METHOD=4 /

&EVAC ID='BallroomOccupants', NUMBER_INITIAL_PERSONS=1000,
      XB=0.0,20.0,0.0,50.0,0.4,1.6, PERS_ID='Occupant',
      KNOWN_DOOR_NAMES='WestSouth','WestNorth','EastSouth','EastNorth',
      KNOWN_DOOR_PROBS=1.0,1.0,1.0,1.0 /
&EVHO ID='Burner', XB=9.0,11.0,24.0,26.0,0.4,1.6 /

! Guiding flow fields, to check in Smokeview (guide, MESH section).
&SLCF PBZ=1.0, QUANTITY='VELOCITY', VECTOR=.TRUE., EVACUATION=.TRUE. /

&TAIL /
