! Modified 2026-10-08: fire-only FDS 6 input and coupling slices.
! See provenance.json and the collection README for all adjustments.
! Original benchmark material properties and source terms are retained.
&HEAD CHID='DoorAlgo_Cc', TITLE='test A for door algorithm' /
&MESH IJK=100,80,4, XB=0.0,50.0,0.0,40.0,0.0,2.0 /
&TIME T_END=100.0, DT=0.1 /
&MISC NOISE=.FALSE. /
&RADI RADIATION=.FALSE. /
&DUMP SMOKE3D=.TRUE., NFRAMES=200, DT_PART=0.1, DT_HRR=0.5, DT_SLCF=1.0, DT_BNDF=1000000.0, DT_PL3D=1000000.0, DT_ISOF=1000000.0 /
&SURF ID='Fire', HRRPUA=1000.0, COLOR='RASPBERRY' /
&REAC ID='POLYURETHANE', FUEL='myPOLYURETHANE', SOOT_YIELD=0.05, CO_YIELD=0.01, N=1.0, C=6.3, H=7.1, O=2.1 /
&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMIN', SURF_ID='INERT' /
&VENT MB='ZMAX', SURF_ID='INERT' /
&OBST XB=0.0,0.25,0.0,5.25,0.0,2.0, RGB=0.3,0.8,0.2, SURF_ID='INERT' /
&OBST XB=0.0,0.25,6.45,40.0,0.0,2.0, RGB=0.3,0.8,0.2, SURF_ID='INERT' /
&OBST XB=49.5,50.0,0.0,25.25,0.0,2.0, RGB=0.3,0.8,0.2, SURF_ID='INERT' /
&OBST XB=49.5,50.0,26.45,40.0,0.0,2.0, RGB=0.3,0.8,0.2, SURF_ID='INERT' /
&OBST XB=0.0,43.25,0.0,0.25,0.0,2.0, RGB=0.3,0.8,0.2, SURF_ID='INERT' /
&OBST XB=44.75,50.0,0.0,0.25,0.0,2.0, RGB=0.3,0.8,0.2, SURF_ID='INERT' /
&OBST XB=0.0,3.25,39.5,40.0,0.0,2.0, RGB=0.3,0.8,0.2, SURF_ID='INERT' /
&OBST XB=4.45,50.0,39.5,40.0,0.0,2.0, RGB=0.3,0.8,0.2, SURF_ID='INERT' /
&OBST XB=0.0,20.0,30.0,30.25,0.0,2.0, RGB=0.3,0.8,0.2, SURF_ID='INERT' /
&OBST XB=30.0,50.0,30.0,30.25,0.0,2.0, RGB=0.3,0.8,0.2, SURF_ID='INERT' /
&OBST XB=10.0,20.0,10.0,10.25,0.0,2.0, RGB=0.3,0.8,0.2, SURF_ID='INERT' /
&OBST XB=22.0,30.25,10.0,10.25,0.0,2.0, RGB=0.3,0.8,0.2, SURF_ID='INERT' /
&OBST XB=10.0,10.25,0.0,20.0,0.0,2.0, RGB=0.3,0.8,0.2, SURF_ID='INERT' /
&OBST XB=30.0,30.25,0.0,10.25,0.0,2.0, RGB=0.3,0.8,0.2, SURF_ID='INERT' /
&OBST XB=35.0,35.25,20.0,30.0,0.0,2.0, RGB=0.3,0.8,0.2, SURF_ID='INERT' /
&OBST XB=30.0,32.0,1.0,3.0,0.0,0.5, SURF_ID='INERT' /
&VENT XB=30.0,32.0,1.0,3.0,0.5,0.5, SURF_ID='Fire', RGB=0.9,0.2,0.2 /
&SLCF PBZ=1.75, QUANTITY='VISIBILITY', CELL_CENTERED=.TRUE. /
&SLCF PBZ=1.75, QUANTITY='DENSITY', SPEC_ID='SOOT', CELL_CENTERED=.TRUE. /
&SLCF PBZ=1.75, QUANTITY='EXTINCTION COEFFICIENT' /
&SLCF PBZ=1.75, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE' /
&SLCF PBZ=1.75, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON DIOXIDE' /
&SLCF PBZ=1.75, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN' /
&SLCF PBZ=1.75, QUANTITY='TEMPERATURE' /
&TAIL /
