! SPDX-License-Identifier: GPL-3.0-only
! Derived from Timo Korhonen / VTT FDS+Evac guide.
! Original: https://github.com/tkorhon1/FDS-Evac-Guide/blob/10eb1a4448ae771ad2187a238a8330c819550008/InputFiles/Verification/FED_Test/fed_verificationB.fds
! Modified 2026-10-08: fire-only FDS 6 input and coupling slices.
! See provenance.json and the collection README for all adjustments.
! Original benchmark material properties and source terms are retained.
&HEAD CHID='fed_verificationB', TITLE='Verification test for FED calculation' /
&MESH IJK=15,15,15, XB=0.0,3.0,0.0,3.0,0.0,3.0 /
&TIME T_END=100.0, DT=0.1 /
&DUMP SMOKE3D=.TRUE., NFRAMES=200, DT_PART=0.5, DT_HRR=0.5, DT_SLCF=0.5, DT_BNDF=1000000.0, DT_PL3D=1000000.0, DT_ISOF=1000000.0 /
&MISC TMPA=20.0 /
&REAC ID='POLYURETHANE', FUEL='myPOLYURETHANE', SOOT_YIELD=0.0, CO_YIELD=0.0, N=1.0, C=6.3, H=7.1, O=2.1 /
&SPEC ID='CARBON DIOXIDE', MASS_FRACTION_0=0.030429 /
&SPEC ID='CARBON MONOXIDE', MASS_FRACTION_0=0.000968 /
&SPEC ID='NITROGEN', MASS_FRACTION_0=0.256084 /
&SLCF PBY=1.5, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON DIOXIDE' /
&SLCF PBY=1.5, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE' /
&SLCF PBY=1.5, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN' /
&DEVC XYZ=1.5,1.5,1.7, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON DIOXIDE', ID='co2' /
&DEVC XYZ=1.5,1.5,1.7, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE', ID='co' /
&DEVC XYZ=1.5,1.5,1.7, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN', ID='o2' /
&DEVC XYZ=1.5,1.5,1.7, QUANTITY='FED', ID='Fed' /
&SPEC ID='SOOT', MASS_FRACTION_0=0.0 /
&SLCF PBZ=1.7, QUANTITY='EXTINCTION COEFFICIENT' /
&SLCF PBZ=1.7, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE' /
&SLCF PBZ=1.7, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON DIOXIDE' /
&SLCF PBZ=1.7, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN' /
&SLCF PBZ=1.7, QUANTITY='TEMPERATURE' /
&TAIL /
