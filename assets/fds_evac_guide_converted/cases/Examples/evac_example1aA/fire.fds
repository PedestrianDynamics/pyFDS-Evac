! SPDX-License-Identifier: GPL-3.0-only
! Derived from Timo Korhonen / VTT FDS+Evac guide.
! Original: https://github.com/tkorhon1/FDS-Evac-Guide/blob/10eb1a4448ae771ad2187a238a8330c819550008/InputFiles/Examples/evac_example1aA.fds
! Modified 2026-10-08: fire-only FDS 6 input and coupling slices.
! See provenance.json and the collection README for all adjustments.
! Original benchmark material properties and source terms are retained.
&HEAD CHID='evac_example1aA', TITLE='Test 1, fire+evac' /
&MESH IJK=54,50,12, XB=-0.2,10.6,0.0,10.0,0.0,2.4 /
&TIME T_END=200.0 /
&DUMP SMOKE3D=.TRUE., NFRAMES=200, DT_PART=0.5, DT_HRR=1.0, DT_SLCF=1.0, DT_BNDF=5.0, DT_PL3D=100.0, DT_ISOF=5.0 /
&REAC ID='PROPANE', FUEL='PROPANE', SOOT_YIELD=0.1, CO_YIELD=0.05 /
&SURF ID='BURNER', HRRPUA=1000.0, COLOR='RASPBERRY' /
&MATL ID='GYPSUM PLASTER', FYI='Quintiere, Fire Behavior', CONDUCTIVITY=0.48, SPECIFIC_HEAT=0.84, DENSITY=1440.0 /
&SURF ID='WALL', DEFAULT=.TRUE., RGB=100,100,100, MATL_ID='GYPSUM PLASTER', THICKNESS=0.012 /
&OBST XB=-0.2,0.0,-0.2,10.2,0.0,2.4, SURF_ID='WALL' /
&OBST XB=10.0,10.2,-0.2,10.2,0.0,2.4, SURF_ID='WALL' /
&OBST XB=-0.2,10.2,-0.2,0.0,0.0,2.4, SURF_ID='WALL' /
&OBST XB=-0.2,10.2,10.0,10.2,0.0,2.4, SURF_ID='WALL' /
&OBST XB=10.0,11.6,4.2,4.4,0.0,2.4, SURF_ID='WALL' /
&OBST XB=10.0,11.6,5.6,5.8,0.0,2.4 /
&HOLE XB=-0.21,0.01,4.39,5.61,0.0,2.0 /
&HOLE XB=9.99,10.21,4.39,5.61,0.0,2.0 /
&OBST XB=3.0,4.0,3.0,4.0,0.0,0.6, SURF_ID='INERT' /
&VENT XB=3.0,4.0,3.0,4.0,0.6,0.6, SURF_ID='BURNER' /
&VENT XB=-0.2,-0.2,4.4,5.6,0.0,2.0, SURF_ID='OPEN', COLOR='GREEN' /
&VENT XB=10.6,10.6,4.4,5.6,0.0,2.0, SURF_ID='OPEN', COLOR='GREEN' /
&BNDF QUANTITY='WALL TEMPERATURE' /
&SLCF PBX=3.5, QUANTITY='TEMPERATURE' /
&SLCF PBX=3.5, QUANTITY='VELOCITY' /
&SLCF PBX=3.5, QUANTITY='PRESSURE' /
&SLCF PBY=5.0, QUANTITY='TEMPERATURE' /
&SLCF PBY=5.0, QUANTITY='VELOCITY' /
&SLCF PBY=5.0, QUANTITY='PRESSURE' /
&SLCF PBZ=1.6, QUANTITY='EXTINCTION COEFFICIENT' /
&SLCF PBZ=1.6, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE' /
&SLCF PBZ=1.6, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON DIOXIDE' /
&SLCF PBZ=1.6, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN' /
&SLCF PBZ=1.6, QUANTITY='TEMPERATURE' /
&TAIL /
