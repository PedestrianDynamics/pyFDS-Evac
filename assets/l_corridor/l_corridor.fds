&HEAD CHID='l_corridor', TITLE='L-corridor: near exit smoked, far exit clean' /

! Generated by pyfds_evac/core/wkt_to_fds.py from assets/l_corridor/geometry.wkt
!   wkt_to_fds(wkt, dx=0.25, z_max=4.0, chid='l_corridor', margin_cells=0,
!              slice_height_m=2.0, hrrpua=1000.0, burner_size_m=1.0,
!              fire_xy=(5.0, 1.5), meshes=(4, 2), t_end=400.0)
! margin_cells=0 puts the mesh exactly on the walkable bounds, so the two exit
! planes below are real domain boundaries rather than vents buried in a wall.
!
! The generator's &MESH block (a 4x2 tiling of the 45 x 28 m bounding box,
! 322k cells) and its three wall &OBSTs have been replaced by the meshes below.
! An L-corridor occupies 261 m2 of a 1260 m2 bounding box, so the tiling spent
! 80% of its cells inside solid rock -- one of the eight tiles was 100% solid
! and still time-stepped and synchronised every step, and the mesh holding the
! fire was 40k cells when 9k would do.  Corridor-hugging meshes cut the domain
! to 67k cells and the largest mesh to 9216, roughly 4x on wall clock.
!
! Because every mesh now hugs a corridor, the walls are the external mesh
! boundaries (solid by default in FDS) and no &OBST is needed at all.  The
! rasterised complement the generator emits is therefore dropped rather than
! left in place: an &OBST that only grazes a mesh face can be snapped to a
! one-cell sheet *inside* the mesh, which here would seal the vertical leg.
!
! --- 8 meshes hugging the three corridors, one per MPI process ---
! bottom corridor, y = 0..3 (mesh 1 holds the fire; the burner spans
! x = 4.5..5.5, well clear of the mesh boundary at x = 10)
&MESH IJK=40,12,16, XB= 0.0,10.0,  0.0, 3.0, 0.0,4.0 /
&MESH IJK=48,12,16, XB=10.0,22.0,  0.0, 3.0, 0.0,4.0 /
&MESH IJK=32,12,16, XB=22.0,30.0,  0.0, 3.0, 0.0,4.0 /
! vertical leg, x = 10..13
&MESH IJK=12,44,16, XB=10.0,13.0,  3.0,14.0, 0.0,4.0 /
&MESH IJK=12,44,16, XB=10.0,13.0, 14.0,25.0, 0.0,4.0 /
! top corridor, y = 25..28
&MESH IJK=48,12,16, XB=10.0,22.0, 25.0,28.0, 0.0,4.0 /
&MESH IJK=48,12,16, XB=22.0,34.0, 25.0,28.0, 0.0,4.0 /
&MESH IJK=44,12,16, XB=34.0,45.0, 25.0,28.0, 0.0,4.0 /
&TIME T_END=400.0 /
&MISC TMPA=20.0 /

! --- exits: both ends open to the outside ---
! Without these the domain is sealed, smoke backs up everywhere and the
! near/far contrast this asset exists to produce disappears.
! exit A (west, near), then exit B (east, far):
&VENT XB= 0.0, 0.0,  0.0, 3.0, 0.0,4.0, SURF_ID='OPEN' /
&VENT XB=45.0,45.0, 25.0,28.0, 0.0,4.0, SURF_ID='OPEN' /

! --- fire ---
! 1 MW, not the 2 MW of assets/t_junction: at 2 MW the extinction field
! saturates (median K ~ 10.7 /m, Jin sighting distance 0.28 m) and every route
! is refused, which measures lethality rather than route choice.  Propane with
! a well-ventilated soot yield keeps K in the range where 3/K is a meaningful
! sighting distance on one route and still walkable on the other.
&REAC FUEL='PROPANE', SOOT_YIELD=0.06, CO_YIELD=0.01 /
! The burner sits on the *near* route, between exit A and the junction.  Put it
! east of the junction instead and the far route -- which leaves the bottom
! corridor at x = 10..13 -- starts closer to the fire than exit A does, so the
! long branch is the smokier one and the contrast inverts.  See README.md.
&VENT XB=4.500,5.500,1.000,2.000,0.0,0.0, SURF_ID='BURNER' /
&SURF ID='BURNER', HRRPUA=1000.0, COLOR='RED', RAMP_Q='qramp' /
! Ramp to full in 45 s and hold: the asset needs a *sustained* contrast window,
! so the fire must reach steady output early and stay there for the rest of the run.
&RAMP ID='qramp', T=  0.0, F=0.00 /
&RAMP ID='qramp', T= 15.0, F=0.25 /
&RAMP ID='qramp', T= 30.0, F=0.70 /
&RAMP ID='qramp', T= 45.0, F=1.00 /
&RAMP ID='qramp', T=400.0, F=1.00 /

! --- analysis slices at z=2.0 m (pyFDS-Evac quantities) ---
&SLCF PBZ=2.0, QUANTITY='EXTINCTION COEFFICIENT' /
&SLCF PBZ=2.0, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE' /
&SLCF PBZ=2.0, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON DIOXIDE' /
&SLCF PBZ=2.0, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN' /
&SLCF PBZ=2.0, QUANTITY='VISIBILITY' /
&DUMP DT_SLCF=2.0 /

! --- point diagnostics on the two routes at head height ---
&DEVC XB= 5.0, 5.0, 1.5,1.5, 2.0,2.0, QUANTITY='EXTINCTION COEFFICIENT', ID='K_fire' /
&DEVC XB= 2.5, 2.5, 1.5,1.5, 2.0,2.0, QUANTITY='EXTINCTION COEFFICIENT', ID='K_near_mid' /
&DEVC XB=15.0,15.0, 1.5,1.5, 2.0,2.0, QUANTITY='EXTINCTION COEFFICIENT', ID='K_spawn' /
&DEVC XB= 0.5, 0.5, 1.5,1.5, 2.0,2.0, QUANTITY='EXTINCTION COEFFICIENT', ID='K_near_exitA' /
&DEVC XB=11.5,11.5,14.0,14.0, 2.0,2.0, QUANTITY='EXTINCTION COEFFICIENT', ID='K_far_leg' /
&DEVC XB=27.5,27.5,26.5,26.5, 2.0,2.0, QUANTITY='EXTINCTION COEFFICIENT', ID='K_far_top' /
&DEVC XB=44.5,44.5,26.5,26.5, 2.0,2.0, QUANTITY='EXTINCTION COEFFICIENT', ID='K_far_exitB' /
&DEVC XB=11.5,11.5, 1.5,1.5, 2.0,2.0, QUANTITY='EXTINCTION COEFFICIENT', ID='K_junction' /

&TAIL /
