&HEAD CHID='heat_radiometer_layer_274',
      TITLE='#308 layer room with layer-height, upper/lower temperature and absorption columns (#274)' /

! Purpose: issue #274, decision D6/D7 of plans/heat-274-276/contract.md:
! FDS interface height, T_u and kappa at the 7 #308 columns, for V9-V12
! (contract Sec. 5.4). PATH_LENGTH is not set, so FDS uses its default
! (0.1 m, UG 6.10.1 Sec. 14.3.1). heat_radiometer_layer_274_pl.fds is the
! same deck with PATH_LENGTH = 1.8 x layer depth (open item O3).
! Copy of heat_radiometer_layer_308.fds: fire (none), layer, mesh, &PROP and
! every device of #308 unchanged; adds the layer columns below.
! Room 4 x 4 x 3 m, 0.1 m cells, four meshes split along x. Room size and
! grid are assumptions of this deck (#224), not sourced values.
! Run with: mpiexec -n 4 fds <deck>.fds
! Copy of heat_radiometer_layer.fds for the layer regime of the heat model
! (#308): adds the TEMPERATURE slice at 2.5 m (mid-layer) and the device
! T_z25 on that slice. Every other namelist is unchanged.
! The z-grid has cell faces at 1.6 and 1.8 m, so the slices below stay at
! those heights.
&MESH ID='M1', IJK=10,40,30, XB=0,1, 0,4, 0,3 /
&MESH ID='M2', IJK=10,40,30, XB=1,2, 0,4, 0,3 /
&MESH ID='M3', IJK=10,40,30, XB=2,3, 0,4, 0,3 /
&MESH ID='M4', IJK=10,40,30, XB=3,4, 0,4, 0,3 /

&TIME T_END=10. /
&MISC TMPA=20. /

! Adiabatic on all six faces: walls exchange no net heat with the room, so
! they re-emit what they absorb.
&SURF ID='ADIABATIC_WALL', ADIABATIC=.TRUE. /
&VENT MB='XMIN', SURF_ID='ADIABATIC_WALL' /
&VENT MB='XMAX', SURF_ID='ADIABATIC_WALL' /
&VENT MB='YMIN', SURF_ID='ADIABATIC_WALL' /
&VENT MB='YMAX', SURF_ID='ADIABATIC_WALL' /
&VENT MB='ZMIN', SURF_ID='ADIABATIC_WALL' /
&VENT MB='ZMAX', SURF_ID='ADIABATIC_WALL' /

! Soot makes the gas absorb and emit; clear hot air is almost transparent.
! Soot mass fraction and temperature are assumptions of this deck (#224),
! not sourced values.
&SPEC ID='SOOT' /

! Hot sooty upper layer from 2.0 m to the ceiling, no fire. Its base is
! 0.2 m above the highest device. The 2.0 m base is an assumption of this
! deck (#224), not a sourced value.
&INIT XB=0,4,0,4,2.0,3, TEMPERATURE=300., SPEC_ID(1)='SOOT', MASS_FRACTION(1)=0.005 /

! Skin: gauge at 35 C (GAUGE_TEMPERATURE), emissivity 1 (FDS default, taken
! as the skin emissivity: an assumption, not a sourced value), and
! h = 8 W/(m2 K). 35 C and h are prescribed by issue #224 (spec 016
! leaves h and T_skin open). FDS UG Eqs. 22.35-22.36: the gauge and the
! radiometer share the gauge temperature, so gauge - radiometer =
! h (T_g - 35 C).
&PROP ID='skin', GAUGE_TEMPERATURE=35., HEAT_TRANSFER_COEFFICIENT=8. /

! Every array has TEMPERATURE and INTEGRATED INTENSITY at the same points,
! and gauges and radiometers facing up, +x, -x and down.
! TIME_HISTORY=T writes each point to _devc.csv (without it FDS writes a
! time-averaged _line.csv).
&DEVC ID='T_z16', QUANTITY='TEMPERATURE', XBP=0.45,3.45,2.05,2.05,1.6,1.6, POINTS=7, TIME_HISTORY=T /
&DEVC ID='U_z16', QUANTITY='INTEGRATED INTENSITY', XBP=0.45,3.45,2.05,2.05,1.6,1.6, POINTS=7, TIME_HISTORY=T /
&DEVC ID='GAUGE_z16_up', QUANTITY='GAUGE HEAT FLUX GAS', ORIENTATION=0,0,1,
      PROP_ID='skin', XBP=0.45,3.45,2.05,2.05,1.6,1.6, POINTS=7, TIME_HISTORY=T /
&DEVC ID='RAD_z16_up', QUANTITY='RADIOMETER GAS', ORIENTATION=0,0,1,
      PROP_ID='skin', XBP=0.45,3.45,2.05,2.05,1.6,1.6, POINTS=7, TIME_HISTORY=T /
&DEVC ID='GAUGE_z16_px', QUANTITY='GAUGE HEAT FLUX GAS', ORIENTATION=1,0,0,
      PROP_ID='skin', XBP=0.45,3.45,2.05,2.05,1.6,1.6, POINTS=7, TIME_HISTORY=T /
&DEVC ID='RAD_z16_px', QUANTITY='RADIOMETER GAS', ORIENTATION=1,0,0,
      PROP_ID='skin', XBP=0.45,3.45,2.05,2.05,1.6,1.6, POINTS=7, TIME_HISTORY=T /
&DEVC ID='GAUGE_z16_mx', QUANTITY='GAUGE HEAT FLUX GAS', ORIENTATION=-1,0,0,
      PROP_ID='skin', XBP=0.45,3.45,2.05,2.05,1.6,1.6, POINTS=7, TIME_HISTORY=T /
&DEVC ID='RAD_z16_mx', QUANTITY='RADIOMETER GAS', ORIENTATION=-1,0,0,
      PROP_ID='skin', XBP=0.45,3.45,2.05,2.05,1.6,1.6, POINTS=7, TIME_HISTORY=T /
&DEVC ID='GAUGE_z16_dn', QUANTITY='GAUGE HEAT FLUX GAS', ORIENTATION=0,0,-1,
      PROP_ID='skin', XBP=0.45,3.45,2.05,2.05,1.6,1.6, POINTS=7, TIME_HISTORY=T /
&DEVC ID='RAD_z16_dn', QUANTITY='RADIOMETER GAS', ORIENTATION=0,0,-1,
      PROP_ID='skin', XBP=0.45,3.45,2.05,2.05,1.6,1.6, POINTS=7, TIME_HISTORY=T /

&DEVC ID='T_z25', QUANTITY='TEMPERATURE', XBP=0.45,3.45,2.05,2.05,2.5,2.5, POINTS=7, TIME_HISTORY=T /

&DEVC ID='T_z18', QUANTITY='TEMPERATURE', XBP=0.45,3.45,2.05,2.05,1.8,1.8, POINTS=7, TIME_HISTORY=T /
&DEVC ID='U_z18', QUANTITY='INTEGRATED INTENSITY', XBP=0.45,3.45,2.05,2.05,1.8,1.8, POINTS=7, TIME_HISTORY=T /
&DEVC ID='GAUGE_z18_up', QUANTITY='GAUGE HEAT FLUX GAS', ORIENTATION=0,0,1,
      PROP_ID='skin', XBP=0.45,3.45,2.05,2.05,1.8,1.8, POINTS=7, TIME_HISTORY=T /
&DEVC ID='RAD_z18_up', QUANTITY='RADIOMETER GAS', ORIENTATION=0,0,1,
      PROP_ID='skin', XBP=0.45,3.45,2.05,2.05,1.8,1.8, POINTS=7, TIME_HISTORY=T /
&DEVC ID='GAUGE_z18_px', QUANTITY='GAUGE HEAT FLUX GAS', ORIENTATION=1,0,0,
      PROP_ID='skin', XBP=0.45,3.45,2.05,2.05,1.8,1.8, POINTS=7, TIME_HISTORY=T /
&DEVC ID='RAD_z18_px', QUANTITY='RADIOMETER GAS', ORIENTATION=1,0,0,
      PROP_ID='skin', XBP=0.45,3.45,2.05,2.05,1.8,1.8, POINTS=7, TIME_HISTORY=T /
&DEVC ID='GAUGE_z18_mx', QUANTITY='GAUGE HEAT FLUX GAS', ORIENTATION=-1,0,0,
      PROP_ID='skin', XBP=0.45,3.45,2.05,2.05,1.8,1.8, POINTS=7, TIME_HISTORY=T /
&DEVC ID='RAD_z18_mx', QUANTITY='RADIOMETER GAS', ORIENTATION=-1,0,0,
      PROP_ID='skin', XBP=0.45,3.45,2.05,2.05,1.8,1.8, POINTS=7, TIME_HISTORY=T /
&DEVC ID='GAUGE_z18_dn', QUANTITY='GAUGE HEAT FLUX GAS', ORIENTATION=0,0,-1,
      PROP_ID='skin', XBP=0.45,3.45,2.05,2.05,1.8,1.8, POINTS=7, TIME_HISTORY=T /
&DEVC ID='RAD_z18_dn', QUANTITY='RADIOMETER GAS', ORIENTATION=0,0,-1,
      PROP_ID='skin', XBP=0.45,3.45,2.05,2.05,1.8,1.8, POINTS=7, TIME_HISTORY=T /

! Layer columns (#274, contract Sec. 5.2 L2 and 5.3 E1), one per device x
! of the #308 line (y = 2.05 m), k = 1-7 as in T_z16-k. LAYER HEIGHT,
! UPPER TEMPERATURE and LOWER TEMPERATURE on a vertical line from floor to
! ceiling (FDS UG 6.10.1 Sec. 22.10.7, Janssens & Tran reduction).
! ABSORPTION COEFFICIENT and TEMPERATURE at the 30 cell centres of the
! column (z = 0.05-2.95 m) give kappa-bar over the layer for E1 and the
! T^4 mean of the open point D7.
&DEVC ID='LH_c1', QUANTITY='LAYER HEIGHT', XB=0.45,0.45,2.05,2.05,0.0,3.0 /
&DEVC ID='TU_c1', QUANTITY='UPPER TEMPERATURE', XB=0.45,0.45,2.05,2.05,0.0,3.0 /
&DEVC ID='TL_c1', QUANTITY='LOWER TEMPERATURE', XB=0.45,0.45,2.05,2.05,0.0,3.0 /
&DEVC ID='KAPPA_c1', QUANTITY='ABSORPTION COEFFICIENT', XBP=0.45,0.45,2.05,2.05,0.05,2.95, POINTS=30, TIME_HISTORY=T /
&DEVC ID='TCOL_c1', QUANTITY='TEMPERATURE', XBP=0.45,0.45,2.05,2.05,0.05,2.95, POINTS=30, TIME_HISTORY=T /
&DEVC ID='LH_c2', QUANTITY='LAYER HEIGHT', XB=0.95,0.95,2.05,2.05,0.0,3.0 /
&DEVC ID='TU_c2', QUANTITY='UPPER TEMPERATURE', XB=0.95,0.95,2.05,2.05,0.0,3.0 /
&DEVC ID='TL_c2', QUANTITY='LOWER TEMPERATURE', XB=0.95,0.95,2.05,2.05,0.0,3.0 /
&DEVC ID='KAPPA_c2', QUANTITY='ABSORPTION COEFFICIENT', XBP=0.95,0.95,2.05,2.05,0.05,2.95, POINTS=30, TIME_HISTORY=T /
&DEVC ID='TCOL_c2', QUANTITY='TEMPERATURE', XBP=0.95,0.95,2.05,2.05,0.05,2.95, POINTS=30, TIME_HISTORY=T /
&DEVC ID='LH_c3', QUANTITY='LAYER HEIGHT', XB=1.45,1.45,2.05,2.05,0.0,3.0 /
&DEVC ID='TU_c3', QUANTITY='UPPER TEMPERATURE', XB=1.45,1.45,2.05,2.05,0.0,3.0 /
&DEVC ID='TL_c3', QUANTITY='LOWER TEMPERATURE', XB=1.45,1.45,2.05,2.05,0.0,3.0 /
&DEVC ID='KAPPA_c3', QUANTITY='ABSORPTION COEFFICIENT', XBP=1.45,1.45,2.05,2.05,0.05,2.95, POINTS=30, TIME_HISTORY=T /
&DEVC ID='TCOL_c3', QUANTITY='TEMPERATURE', XBP=1.45,1.45,2.05,2.05,0.05,2.95, POINTS=30, TIME_HISTORY=T /
&DEVC ID='LH_c4', QUANTITY='LAYER HEIGHT', XB=1.95,1.95,2.05,2.05,0.0,3.0 /
&DEVC ID='TU_c4', QUANTITY='UPPER TEMPERATURE', XB=1.95,1.95,2.05,2.05,0.0,3.0 /
&DEVC ID='TL_c4', QUANTITY='LOWER TEMPERATURE', XB=1.95,1.95,2.05,2.05,0.0,3.0 /
&DEVC ID='KAPPA_c4', QUANTITY='ABSORPTION COEFFICIENT', XBP=1.95,1.95,2.05,2.05,0.05,2.95, POINTS=30, TIME_HISTORY=T /
&DEVC ID='TCOL_c4', QUANTITY='TEMPERATURE', XBP=1.95,1.95,2.05,2.05,0.05,2.95, POINTS=30, TIME_HISTORY=T /
&DEVC ID='LH_c5', QUANTITY='LAYER HEIGHT', XB=2.45,2.45,2.05,2.05,0.0,3.0 /
&DEVC ID='TU_c5', QUANTITY='UPPER TEMPERATURE', XB=2.45,2.45,2.05,2.05,0.0,3.0 /
&DEVC ID='TL_c5', QUANTITY='LOWER TEMPERATURE', XB=2.45,2.45,2.05,2.05,0.0,3.0 /
&DEVC ID='KAPPA_c5', QUANTITY='ABSORPTION COEFFICIENT', XBP=2.45,2.45,2.05,2.05,0.05,2.95, POINTS=30, TIME_HISTORY=T /
&DEVC ID='TCOL_c5', QUANTITY='TEMPERATURE', XBP=2.45,2.45,2.05,2.05,0.05,2.95, POINTS=30, TIME_HISTORY=T /
&DEVC ID='LH_c6', QUANTITY='LAYER HEIGHT', XB=2.95,2.95,2.05,2.05,0.0,3.0 /
&DEVC ID='TU_c6', QUANTITY='UPPER TEMPERATURE', XB=2.95,2.95,2.05,2.05,0.0,3.0 /
&DEVC ID='TL_c6', QUANTITY='LOWER TEMPERATURE', XB=2.95,2.95,2.05,2.05,0.0,3.0 /
&DEVC ID='KAPPA_c6', QUANTITY='ABSORPTION COEFFICIENT', XBP=2.95,2.95,2.05,2.05,0.05,2.95, POINTS=30, TIME_HISTORY=T /
&DEVC ID='TCOL_c6', QUANTITY='TEMPERATURE', XBP=2.95,2.95,2.05,2.05,0.05,2.95, POINTS=30, TIME_HISTORY=T /
&DEVC ID='LH_c7', QUANTITY='LAYER HEIGHT', XB=3.45,3.45,2.05,2.05,0.0,3.0 /
&DEVC ID='TU_c7', QUANTITY='UPPER TEMPERATURE', XB=3.45,3.45,2.05,2.05,0.0,3.0 /
&DEVC ID='TL_c7', QUANTITY='LOWER TEMPERATURE', XB=3.45,3.45,2.05,2.05,0.0,3.0 /
&DEVC ID='KAPPA_c7', QUANTITY='ABSORPTION COEFFICIENT', XBP=3.45,3.45,2.05,2.05,0.05,2.95, POINTS=30, TIME_HISTORY=T /
&DEVC ID='TCOL_c7', QUANTITY='TEMPERATURE', XBP=3.45,3.45,2.05,2.05,0.05,2.95, POINTS=30, TIME_HISTORY=T /

&SLCF PBZ=1.6, QUANTITY='INTEGRATED INTENSITY' /
&SLCF PBZ=1.8, QUANTITY='INTEGRATED INTENSITY' /
&SLCF PBZ=1.6, QUANTITY='TEMPERATURE' /
&SLCF PBZ=1.8, QUANTITY='TEMPERATURE' /
&SLCF PBZ=2.5, QUANTITY='TEMPERATURE' /
&SLCF PBY=2.05, QUANTITY='TEMPERATURE' /
&SLCF PBY=2.05, QUANTITY='INTEGRATED INTENSITY' /

&TAIL /
