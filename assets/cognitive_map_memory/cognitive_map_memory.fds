&HEAD CHID='cognitive_map_memory', TITLE='Generated from JuPedSim walkable WKT' /
&MESH IJK=22,130,12, XB=-0.250,5.250,-0.250,32.250,0.0,3.0 /
&TIME T_END=120.0 /
&MISC TMPA=20.0 /

! --- walls: complement of the walkable area (6 OBSTs) ---
&OBST XB=-0.250,5.250,-0.250,0.000,0.0,3.0 /
&OBST XB=-0.250,0.000,0.000,32.250,0.0,3.0 /
&OBST XB=0.000,5.250,32.000,32.250,0.0,3.0 /
&OBST XB=4.000,5.250,0.000,19.000,0.0,3.0 /
&OBST XB=4.000,5.250,21.000,32.000,0.0,3.0 /
&OBST XB=5.000,5.250,19.000,21.000,0.0,3.0 /

! --- fire (edit to taste; not derived from geometry) ---
&REAC FUEL='PROPANE', SOOT_YIELD=0.06, CO_YIELD=0.01 /

! --- analysis slices at z=2.0 m (pyFDS-Evac quantities) ---
&SLCF PBZ=2.0, QUANTITY='EXTINCTION COEFFICIENT' /
&SLCF PBZ=2.0, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE' /
&SLCF PBZ=2.0, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON DIOXIDE' /
&SLCF PBZ=2.0, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN' /
&DUMP DT_SLCF=2.0 /

&TAIL /
