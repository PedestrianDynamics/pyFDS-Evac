&HEAD CHID='a047_cvm2_h40', TITLE='Route choice after Schroeder et al. 2015: Room 3 fire, alpha 0.0469, CVM2, H 4.0 m, dx 0.2 m' /

! Geometry after Schroeder et al. 2015 Fig. 6 / Schroeder 2017 Fig. 3.9
! (digitised, +-0.5-1 m, snapped to 0.2 m); see
! assets/schroeder2015_route/geometry.py. Sensitivity fire added after the
! routing runs (#419); not run. Tags: [R] C/VM2 design fire, [D] digitised, [A] assumed. See
! assets/schroeder2015_route/README.md.

! --- Domain: corridor x -5..0, y -10..35; hall + Room 3 x 0..10.6, y 0..31 ---
! Meshes cover the floor footprint only; H = 4.0 m, dz = 0.2000 m.
&MESH ID='M1', IJK=25,112,20, XB=-5.0,0.0,-10.0,12.4,0.0,4.00 /
&MESH ID='M2', IJK=25,113,20, XB=-5.0,0.0,12.4,35.0,0.0,4.00 /
&MESH ID='M3', IJK=53,39,20, XB=0.0,10.6,0.0,7.8,0.0,4.00 /
&MESH ID='M4', IJK=53,39,20, XB=0.0,10.6,7.8,15.6,0.0,4.00 /
&MESH ID='M5', IJK=53,39,20, XB=0.0,10.6,15.6,23.4,0.0,4.00 /
&MESH ID='M6', IJK=53,38,20, XB=0.0,10.6,23.4,31.0,0.0,4.00 /

&TIME T_END=480 /
&DUMP DT_SLCF=1.0, DT_DEVC=1.0, DT_RESTART=60.0 /

! --- Reaction [R] ---
! NZ C/VM2 pre-flashover design fire, "All buildings" row [R]: growth
! 0.0469 t^2 kW, Ysoot 0.07, YCO 0.04 kg/kg, heat of combustion 20 MJ/kg,
! radiative fraction 0.35. MBIE, C/VM2 Second Edition (effective 28 July 2025),
! Table 2.3.2.1, p. 20; these five values are unchanged from Table 2.1 of the
! 2012 edition (Commentary for C/VM2, Dec 2012, p. 56). Fuel CH2O0.5, the
! generic fuel of note (2) of that table. Not C/VM2: its peak (20 MW, burner
! sized at 500-1000 kW/m2 in CFD) is replaced by the study's 1.5 MW cap on the
! same 250 kW/m2 burner, so only growth and species differ from the main
! fire [A]. Pre-flashover yields only: the
! post-flashover yields (Ysoot 0.14, YCO 0.40 kg/kg after flashover, the
! average upper layer first at 500 C, or after the fire becomes ventilation
! limited; paragraphs 2.3.3.2 and 2.3.3.4) are not modelled.
&SPEC ID='CVM2 FUEL', C=1.0, H=2.0, O=0.5 /
&REAC FUEL='CVM2 FUEL', SOOT_YIELD=0.07, CO_YIELD=0.04,
      HEAT_OF_COMBUSTION=20000., RADIATIVE_FRACTION=0.35 /

! --- Fire: t^2, alpha = 0.0469 kW/s^2, to 1500 kW at 178.8 s [R] ---
! HRRPUA 250 kW/m2 on a 3 x 2 m floor burner centred in Room 3.
&SURF ID='FIRE', HRRPUA=250, TAU_Q=-178.8, COLOR='RED' /
&VENT XB=4.0,7.0,26.6,28.6,0.0,0.0, SURF_ID='FIRE' /

! --- Internal walls and doors (all 2 m wide [D], 2 m high [A]) ---
&OBST XB=0.0,0.2,0.0,31.0,0.0,4.00, COLOR='GRAY 60' /  ! wall x 0-0.2 [A]
&OBST XB=0.0,10.6,24.0,24.2,0.0,4.00, COLOR='GRAY 60' /  ! wall hall/Room 3 [A]
&HOLE XB=-0.1,0.3,0.6,2.6,0.0,2.0 /  ! door A, 2 m wide, 2 m high
&HOLE XB=-0.1,0.3,20.6,22.6,0.0,2.0 /  ! door B, 2 m wide, 2 m high
&HOLE XB=-0.1,0.3,26.6,28.6,0.0,2.0 /  ! door D, 2 m wide, 2 m high
&HOLE XB=4.4,6.4,23.9,24.3,0.0,2.0 /  ! door C, open

! --- Exits E, F: open to ambient on the corridor end walls, 2 m high [A] ---
&VENT XB=-3.6,-1.6,-10.0,-10.0,0.0,2.0, SURF_ID='OPEN' /  ! exit E
&VENT XB=-3.6,-1.6,35.0,35.0,0.0,2.0, SURF_ID='OPEN' /  ! exit F

! --- Walls, floor, ceiling: the default INERT boundary [A] ---

! --- Slices: soot extinction at 1.6, 2.0, 2.8 m; CO, CO2, O2, T at 1.6 m ---
&SLCF PBZ=1.6, QUANTITY='EXTINCTION COEFFICIENT' /
&SLCF PBZ=2.0, QUANTITY='EXTINCTION COEFFICIENT' /
&SLCF PBZ=2.8, QUANTITY='EXTINCTION COEFFICIENT' /
&SLCF PBZ=1.6, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE' /
&SLCF PBZ=1.6, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON DIOXIDE' /
&SLCF PBZ=1.6, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN' /
&SLCF PBZ=1.6, QUANTITY='TEMPERATURE' /
&SLCF PBX=-2.5, QUANTITY='EXTINCTION COEFFICIENT' /  ! corridor axis, Smokeview

! --- Device trees at cell centres ---
&DEVC ID='T_corrE', QUANTITY='TEMPERATURE', XBP=-2.5,-2.5,-7.9,-7.9,0.1000,3.9000, POINTS=20, TIME_HISTORY=T /
&DEVC ID='K_corrE', QUANTITY='EXTINCTION COEFFICIENT', XBP=-2.5,-2.5,-7.9,-7.9,0.1000,3.9000, POINTS=20, TIME_HISTORY=T /
&DEVC ID='T_doorA_c', QUANTITY='TEMPERATURE', XBP=-0.9,-0.9,1.5,1.5,0.1000,3.9000, POINTS=20, TIME_HISTORY=T /
&DEVC ID='K_doorA_c', QUANTITY='EXTINCTION COEFFICIENT', XBP=-0.9,-0.9,1.5,1.5,0.1000,3.9000, POINTS=20, TIME_HISTORY=T /
&DEVC ID='T_corr_mid', QUANTITY='TEMPERATURE', XBP=-2.5,-2.5,12.1,12.1,0.1000,3.9000, POINTS=20, TIME_HISTORY=T /
&DEVC ID='K_corr_mid', QUANTITY='EXTINCTION COEFFICIENT', XBP=-2.5,-2.5,12.1,12.1,0.1000,3.9000, POINTS=20, TIME_HISTORY=T /
&DEVC ID='T_doorB_c', QUANTITY='TEMPERATURE', XBP=-0.9,-0.9,21.7,21.7,0.1000,3.9000, POINTS=20, TIME_HISTORY=T /
&DEVC ID='K_doorB_c', QUANTITY='EXTINCTION COEFFICIENT', XBP=-0.9,-0.9,21.7,21.7,0.1000,3.9000, POINTS=20, TIME_HISTORY=T /
&DEVC ID='T_doorD_c', QUANTITY='TEMPERATURE', XBP=-0.9,-0.9,27.7,27.7,0.1000,3.9000, POINTS=20, TIME_HISTORY=T /
&DEVC ID='K_doorD_c', QUANTITY='EXTINCTION COEFFICIENT', XBP=-0.9,-0.9,27.7,27.7,0.1000,3.9000, POINTS=20, TIME_HISTORY=T /
&DEVC ID='T_corrF', QUANTITY='TEMPERATURE', XBP=-2.5,-2.5,33.1,33.1,0.1000,3.9000, POINTS=20, TIME_HISTORY=T /
&DEVC ID='K_corrF', QUANTITY='EXTINCTION COEFFICIENT', XBP=-2.5,-2.5,33.1,33.1,0.1000,3.9000, POINTS=20, TIME_HISTORY=T /
&DEVC ID='T_hall_lo', QUANTITY='TEMPERATURE', XBP=5.5,5.5,6.1,6.1,0.1000,3.9000, POINTS=20, TIME_HISTORY=T /
&DEVC ID='K_hall_lo', QUANTITY='EXTINCTION COEFFICIENT', XBP=5.5,5.5,6.1,6.1,0.1000,3.9000, POINTS=20, TIME_HISTORY=T /
&DEVC ID='T_hall_mid', QUANTITY='TEMPERATURE', XBP=5.5,5.5,12.1,12.1,0.1000,3.9000, POINTS=20, TIME_HISTORY=T /
&DEVC ID='K_hall_mid', QUANTITY='EXTINCTION COEFFICIENT', XBP=5.5,5.5,12.1,12.1,0.1000,3.9000, POINTS=20, TIME_HISTORY=T /
&DEVC ID='T_hall_hi', QUANTITY='TEMPERATURE', XBP=5.5,5.5,18.1,18.1,0.1000,3.9000, POINTS=20, TIME_HISTORY=T /
&DEVC ID='K_hall_hi', QUANTITY='EXTINCTION COEFFICIENT', XBP=5.5,5.5,18.1,18.1,0.1000,3.9000, POINTS=20, TIME_HISTORY=T /
&DEVC ID='T_doorA_h', QUANTITY='TEMPERATURE', XBP=1.1,1.1,1.7,1.7,0.1000,3.9000, POINTS=20, TIME_HISTORY=T /
&DEVC ID='K_doorA_h', QUANTITY='EXTINCTION COEFFICIENT', XBP=1.1,1.1,1.7,1.7,0.1000,3.9000, POINTS=20, TIME_HISTORY=T /
&DEVC ID='T_doorB_h', QUANTITY='TEMPERATURE', XBP=1.1,1.1,21.7,21.7,0.1000,3.9000, POINTS=20, TIME_HISTORY=T /
&DEVC ID='K_doorB_h', QUANTITY='EXTINCTION COEFFICIENT', XBP=1.1,1.1,21.7,21.7,0.1000,3.9000, POINTS=20, TIME_HISTORY=T /
&DEVC ID='T_room3', QUANTITY='TEMPERATURE', XBP=9.1,9.1,29.5,29.5,0.1000,3.9000, POINTS=20, TIME_HISTORY=T /
&DEVC ID='K_room3', QUANTITY='EXTINCTION COEFFICIENT', XBP=9.1,9.1,29.5,29.5,0.1000,3.9000, POINTS=20, TIME_HISTORY=T /

&TAIL /
