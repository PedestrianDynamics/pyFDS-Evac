#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
.idea/

# Data
processed_data

# Legacy: local FDS run output from before decks moved into assets/.
# Nothing here is tracked any more; safe to delete once the runs are archived.
fds_directory

# FDS run output inside assets/<scenario>/. The deck, config.json, geometry.wkt
# and preview images stay tracked; everything FDS generates beside them does
# not. A single run drops well over a hundred of these files.
